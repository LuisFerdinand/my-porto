# Neon / Postgres connection string
DATABASE_URL=

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters, signs the admin session cookie
SESSION_SECRET=

# Cloudinary: fill the three values, or set CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email through Resend (https://resend.com/api-keys). Until RESEND_API_KEY is set, messages are only saved in /admin/messages.
RESEND_API_KEY=
CONTACT_TO=ferdinandluis88@gmail.com
# Sender. Leave it out to use Resend's test sender (delivers only to your own Resend account email).
# After verifying a domain in Resend, use e.g. CONTACT_FROM="Portfolio <contact@yourdomain.com>"
# CONTACT_FROM=
