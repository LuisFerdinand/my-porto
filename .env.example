# Neon / Postgres connection string
DATABASE_URL=

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters, signs the admin session cookie
SESSION_SECRET=

# Cloudinary: fill the three values, or set CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form email. For Gmail, SMTP_PASS is an App Password (Google Account > Security > App passwords)
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
